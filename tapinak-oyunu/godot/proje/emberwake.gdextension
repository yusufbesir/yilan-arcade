[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
windows.debug.x86_64 = "res://bin/debug/emberwake_godot.dll"
windows.release.x86_64 = "res://bin/release/emberwake_godot.dll"
linux.debug.x86_64 = "res://bin/debug/libemberwake_godot.so"
linux.release.x86_64 = "res://bin/release/libemberwake_godot.so"
