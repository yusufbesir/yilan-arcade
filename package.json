{
  "name": "yilan-arcade",
  "version": "0.7.1",
  "description": "Twilight of the Serpents",
  "main": "main.js",
  "author": "Yusuf",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node test/bullet-mode.test.js && node test/tailgun-mode.test.js && node test/survivor-mode.test.js && node test/new-modes.test.js && node test/font-csp.test.js && node test/sound.test.js && node test/settings-ach.test.js && node test/migrate.test.js && node test/gorsel.test.js && node test/tur4.test.js && node test/guvenlik.test.js && node test/arastirma.test.js"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright": "1.49.1"
  },
  "build": {
    "appId": "com.yusuf.yilanarcade",
    "productName": "Twilight of the Serpents",
    "files": [
      "main.js",
      "migrate.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Twilight of the Serpents",
      "artifactName": "Twilight-of-the-Serpents-Setup-${version}.exe"
    }
  }
}